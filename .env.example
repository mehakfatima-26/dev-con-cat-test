DEMO_PIXEL_ORIGIN=http://localhost:3000

# Optional. Fixed login password for every seeded user (super_admin +
# account_admins). Left unset, db/seeds.rb generates a random one on every
# run and prints it to the terminal
# SEED_USER_PASSWORD=

# Optional. Redis connection used for Sidekiq and the pixel's live activity
# pub/sub. Left unset, defaults to redis://localhost:6379/0.
# REDIS_URL=
